# ============================================
# Stripe Configuration
# Get keys from: https://dashboard.stripe.com/apikeys
# ============================================
NEXT_PUBLIC_STRIPE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE

# ============================================
# Melio Configuration
# Get keys from: https://app.melio.com/settings/api
# ============================================
NEXT_PUBLIC_MELIO_KEY=melio_pk_YOUR_MELIO_PUBLIC_KEY_HERE
MELIO_SECRET_KEY=melio_sk_YOUR_MELIO_SECRET_KEY_HERE

# ============================================
# Optional: Plaid Configuration (for bank linking)
# Get keys from: https://dashboard.plaid.com
# ============================================
NEXT_PUBLIC_PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret_key

# ============================================
# Environment
# ============================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000
